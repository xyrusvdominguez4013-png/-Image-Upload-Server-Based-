# Copy this file to .env and fill in real values. .env is git-ignored.

FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-value

# MySQL 8 connection string, e.g.:
# mysql+pymysql://image_demo_user:CHANGE_ME@localhost:3306/image_storage_demo
DATABASE_URL=mysql+pymysql://image_demo_user:CHANGE_ME@localhost:3306/image_storage_demo

UPLOAD_FOLDER=/var/www/image-storage-demo/uploads
MAX_CONTENT_LENGTH=10485760

# The vhost in deployment/apache/*.conf serves plain HTTP (no TLS). Leave
# this unset/false unless you've put the app behind HTTPS -- a "Secure"
# cookie over plain HTTP is silently dropped by the browser and breaks
# CSRF-protected forms ("The CSRF session token is missing").
# SESSION_COOKIE_SECURE=true

LOG_LEVEL=INFO
LOG_FILE=/var/www/image-storage-demo/instance/app.log
